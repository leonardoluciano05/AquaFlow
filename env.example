PORT=3000
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria
APP_BASE_URL=http://localhost:3000

# Google Sign-In (Google Cloud Console > OAuth 2.0 Client ID para Web)
GOOGLE_CLIENT_ID=

# SMTP para enviar os códigos por e-mail.
# Se ficar vazio em desenvolvimento, o código é exibido no terminal e na própria tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AquaFlow <no-reply@aquaflow.local>

# Em produção, use NODE_ENV=production e configure SMTP + HTTPS.
NODE_ENV=development
